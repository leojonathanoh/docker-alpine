{
  "alpine": {
    "versions": [
      "3.24.4",
      "3.20.10",
      "3.17.10",
      "3.15.11",
      "3.12.12"
    ],
    "versionsChangeScope": "minor",
    "versionsNewScript": "Invoke-WebRequest https://www.alpinelinux.org/releases.json | ConvertFrom-Json | % { $_.release_branches } | ? { $_.git_branch -ne 'master' } | % { $_.releases.version } | ? { $v = [version]$_; $v.Major -eq 3 -and $v.Minor -in 24,20,17,15,12 } | Sort-Object { [version]$_ } -Descending"
  },
  "pingme": {
    "versions": [
      "0.2.7"
    ],
    "versionsChangeScope": "minor",
    "versionsNewScript": "Invoke-WebRequest https://api.github.com/repos/kha7iq/pingme/git/refs/tags | ConvertFrom-Json | % { $_.ref -replace 'refs/tags/v', '' } | ? { $_ -match '^\\d+\\.\\d+\\.\\d+$' } | ? { [version]$_ -lt [version]'0.3.0' } | Sort-Object { [version]$_ } -Descending",
    "limit": 1
  }
}
